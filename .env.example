# Demo runs with no keys.
AI_PROVIDER=mock
AI_MODEL=
MISTRAL_API_KEY=
# Meta Model API (AI_PROVIDER=meta): key from MODEL_API_KEY, MUSE_API_KEY or META_API_KEY; model via AI_MODEL (default muse-spark-1.3, Responses API, streaming)
MUSE_API_KEY=
META_API_BASE=https://api.meta.ai/v1
# Browser-exposed token is intentionally limited to map tiles when enabled.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Use only in non-production local test environment:
NEXT_PUBLIC_DEMO_MODE=true
# Optional; protect any usage-bearing server endpoint with rate limits.
MAX_AI_REQUESTS_PER_TRIP=30
