# Copy to .env.local. Never commit .env.local or any real key.
# Restart Next.js after changing modes or keys.
UNCONGEST_MODE=demo
AI_PROVIDER=mock

# Live Muse: set UNCONGEST_MODE=live-muse and AI_PROVIDER=meta.
# Add your own Meta Model API key server-side (never NEXT_PUBLIC_*).
MODEL_API_KEY=
# Existing MUSE_API_KEY / META_API_KEY / META_MODEL_API_KEY aliases are supported.
AI_MODEL=muse-spark-1.3
META_API_BASE=https://api.meta.ai/v1
LLM_MAX_CALLS_PER_10_MIN=30
INTENT_DEADLINE_MS=8000
TACTICAL_DEADLINE_MS=5000
STRATEGIC_DEADLINE_MS=30000

# Optional Full Live: set UNCONGEST_MODE=full-live and AI_PROVIDER=meta.
# These flags cannot enable external providers in demo or live-muse modes.
OSRM_LIVE=1
OVERPASS_LIVE=1
NOMINATIM_LIVE=1
OPEN_METEO_LIVE=1

# TomTom stays OFF. Do not enable during development/tests without approval.
TOMTOM_LIVE=0
TOMTOM_API_KEY=
# Optional hosted services and writable runtime-cache directory:
# OSRM_URL=https://your-router.example
# OVERPASS_URL=https://your-overpass.example/api/interpreter
# UNCONGEST_CACHE_DIR=.cache
